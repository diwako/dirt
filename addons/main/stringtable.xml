<?xml version="1.0" encoding="utf-8"?>
<Project name="dirt">
    <Package name="main">
        <Key ID="STR_DIRT_main_Category">
            <English>D.I.R.T. - Dynamic Textures</English>
        </Key>
        <Key ID="STR_DIRT_main_subcategoryTextures">
            <English>Textures</English>
        </Key>
        <Key ID="STR_DIRT_main_subcategoryMisc">
            <English>Miscellaneous</English>
        </Key>
        <Key ID="STR_DIRT_main_enable">
            <English>Enable</English>
        </Key>
        <Key ID="STR_DIRT_main_affectAI">
            <English>Affect AI</English>
        </Key>
        <Key ID="STR_DIRT_main_affectAI_desc">
            <English>When enabled, AI units will also be given dynamic textures</English>
        </Key>
        <Key ID="STR_DIRT_main_updateFrequency">
            <English>Update Frequency</English>
        </Key>
        <Key ID="STR_DIRT_main_updateFrequency_desc">
            <English>Time in seconds when ever checks should run. Affects speed of textures being applies as well.</English>
        </Key>
        <Key ID="STR_DIRT_main_preWarmUp">
            <English>Pre-Warm up textures</English>
        </Key>
        <Key ID="STR_DIRT_main_preWarmUp_desc">
            <English>When enabled fill the dynamic texture pool first, before main routine starts. Might help with wrong textures being applied in the beginning.</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdyntextures">
            <English>Maximum of dynamic textures</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdyntextures_desc">
            <English>Maximum amount of dynamicly rendered textures. Less saves more VRAM, more means it consumes more VRAM</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdistance">
            <English>Maximum Distance</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdistance_desc">
            <English>System only applies dynamic textures for targets in given range</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdistanceanimations">
            <English>Animation Distance</English>
        </Key>
        <Key ID="STR_DIRT_main_maxdistanceanimations_desc">
            <English>Targets within this range will have their textures animated smoothly</English>
        </Key>
        <Key ID="STR_DIRT_main_sortByDistance">
            <English>Sort units by distance</English>
        </Key>
        <Key ID="STR_DIRT_main_sortByDistance_desc">
            <English>Sorts the units by distance, makes sure that always the closest units get the dynamic textures applied. Might cause visible applying or pop in of textures when many units are around</English>
        </Key>
        <Key ID="STR_DIRT_main_additionalSelections">
            <English>Additional hiddenSelections</English>
        </Key>
        <Key ID="STR_DIRT_main_additionalSelections_desc">
            <English>This is a very technical setting! Adds more entries of allowed hiddenSelection values dynamic textures can get applied to. Value must be comma separated strings without whitespaces and quotation marks.</English>
        </Key>
        <Key ID="STR_DIRT_main_groundincrease">
            <English>Ground Effect Increment</English>
        </Key>
        <Key ID="STR_DIRT_main_groundincrease_desc">
            <English>When crawling around, this amount of dirt or snow is being added to the target</English>
        </Key>
        <Key ID="STR_DIRT_main_grounddecrease">
            <English>Ground Effect Reduction</English>
        </Key>
        <Key ID="STR_DIRT_main_grounddecrease_desc">
            <English>When no longer crawling around, this amound of dirt or snow is being removed</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationincrease">
            <English>Precipitation Effect Increment</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationincrease_desc">
            <English>Amount of snow or dirt being added</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationdecrease">
            <English>Precipitation Effect Reduction</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationdecrease_desc">
            <English>Amound of rain or snow to be removed</English>
        </Key>
        <Key ID="STR_DIRT_main_burnincrease">
            <English>Burn Effect Increment</English>
        </Key>
        <Key ID="STR_DIRT_main_burnincrease_desc">
            <English>Amount of burn effect to be added</English>
        </Key>
        <Key ID="STR_DIRT_main_burndecrease">
            <English>Burn Effect Reduction</English>
        </Key>
        <Key ID="STR_DIRT_main_burndecrease_desc">
            <English>Amount of burn effect to be removed</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationDecreaseDirt">
            <English>Water affects dirt</English>
        </Key>
        <Key ID="STR_DIRT_main_precipitationDecreaseDirt_desc">
            <English>When being exposed to rain or being in water, dirt washes off faster</English>
        </Key>
        <Key ID="STR_DIRT_main_explosionEH">
            <English>Explosion Handling</English>
        </Key>
        <Key ID="STR_DIRT_main_explosionEH_desc">
            <English>Nearby explosions add to texture opacity, such as for dirt, snow or burn textures</English>
        </Key>
    </Package>
</Project>
